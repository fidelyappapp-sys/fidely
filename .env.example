# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
QR_SIGNING_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METERED_PRICE_ID=
STRIPE_PUBLISHABLE_KEY=

# --- Stripe boutique (npm run stripe:boutique-setup) ---
STRIPE_PRICE_DISPLAY_STAND=
STRIPE_PRICE_SHEET=
STRIPE_PRICE_QR=
STRIPE_PRICE_FULL_KIT=
STRIPE_PRICE_NEW_SHOP_KIT=

# --- Stripe Plaque Pro subscription (npm run stripe:plaque-pro-setup) ---
# Separate from STRIPE_METERED_PRICE_ID above (unrelated core subscription).
STRIPE_PRICE_PLAQUE_PRO_MONTHLY=
STRIPE_PRICE_PLAQUE_PRO_ANNUAL=

# --- DeepL (Plaque Pro multilingual menu) --- optional, degrades to
# French-only when unset (see lib/i18n/translateMenu.ts)
DEEPL_API_KEY=

# --- Apple Wallet (see docs/WALLET_SETUP.md) ---
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_CERT=
APPLE_SIGNER_CERT=
APPLE_SIGNER_KEY=
APPLE_SIGNER_KEY_PASSPHRASE=

# --- Google Wallet (see docs/WALLET_SETUP.md) --- auth via a service
# account JSON key, base64-encoded (base64 -i service-account.json)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=

# --- Web Push (VAPID) --- generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@fidely.app

# --- Cron ---
CRON_SECRET=

# --- Admin (/admin) ---
# No env vars needed — access is granted by adding a row to the
# platform_admins table for a real Supabase Auth user (see lib/adminAuth.ts).

# --- Email (Resend) ---
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
